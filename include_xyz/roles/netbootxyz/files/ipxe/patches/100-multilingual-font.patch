+/** Number of glyphs in the embedded font */
+#define LATIN_GLYPH_COUNT ( sizeof ( latin_glyphs ) / sizeof ( latin_glyphs[0] ) )
+
+/**
+ * Look up a glyph in the embedded Latin font
+ *
+ * @v codepoint		Unicode codepoint
+ * @ret bitmap		Pointer to 16-byte bitmap, or NULL if not found
+ */
+const uint8_t * latin_font_glyph ( unsigned int codepoint ) {
+	unsigned int i;
+
+	/* Linear search - could be optimized with binary search if needed */
+	for ( i = 0 ; i < LATIN_GLYPH_COUNT ; i++ ) {
+		if ( latin_glyphs[i].codepoint == codepoint )
+			return latin_glyphs[i].bitmap;
+	}
+
+	return NULL;
+}
